# Data folders
grounding_data
huggingface
data/
# Anchored: an unanchored `datasets/` matches at ANY depth and silently
# excluded the vendored source package LLMDet/mmdet/datasets/ (53 files),
# which made the detector unimportable off this machine. The data dirs it
# was meant to cover are named explicitly on the next two lines.
/datasets/
LLMDet/data/
LLMDet/datasets/

# Logs / outputs
logs/
runs/
outputs/

# System
.DS_Store



# Run outputs & experiment artifacts (results JSONs force-added selectively)
LLMDet/work_dirs/
LLMDet/.dist_test/
train_debug.log

# Media / test assets
*.mp4
*.jfif
tes*.jpg
test*.jpg
*.pkl
*.npz

# Archives & bundles
*.tar.gz
gold_annotation_bundle*

# Dashboard session caches: derived from a video + the detector, ~100 MB each,
# and rebuildable with tools/dashboard/precompute_session.py
tools/dashboard/sessions/

# Gold annotation outputs stay local until finalized
tools/gold_annotator/gold_annotations_*.jsonl
tools/gold_annotator/gold_events_*.jsonl
.claude/

# External datasets (re-downloadable; CMOSE is 13.6 GB)
grounding_data/external/
grounding_data/llmstu_sequences_full_bp/
grounding_data/llmstu_sequences_full_det/
huggingface/mediapipe/*.tflite

# Branch-C error-analysis crops: derived identifiable student media. Blurred, but
# the filenames carry video id + seat + timestamp and the repo is public, so they
# stay local. See FINDINGS 12.4 and docs/branch_c/RELEASE_RISK_REGISTER.md.
outputs/branch_c/error_analysis/crops/
